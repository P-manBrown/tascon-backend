<%# Override https://tinyurl.com/2ysv8kyb %>
<p><%= "#{t(:hello).capitalize}、#{@resource.name}" %>さん。</p>
<p>
  パスワードリセットのリクエストが送信されました。<br/>
  <%= t(".request_reset_link_msg") %>
</p>
<p>
  <%# The link target comes from the edit_password_url helper, so it is always a URL of this application. %>
  <%# nosemgrep: ruby.rails.security.audit.xss.templates.dangerous-link-to %>
  <%= link_to t(".password_change_link"), edit_password_url(@resource, {
    reset_password_token: @token,
    config: message["client-config"].to_s,
    redirect_url: message["redirect-url"].to_s
  }) %>
</p>
<p><%= t(".ignore_mail_msg") %></p>
<p><%= t(".no_changes_msg") %></p>
