{
  "name": "tascon-backend",
  "dockerComposeFile": ["../compose.yml", "./compose.devcontainer.yml"],
  "service": "api",
  "workspaceFolder": "/home/ruby/tascon-backend",
  // TEMP: without remoteUser, Zed connects as root
  "remoteUser": "ruby",
  "overrideCommand": true,
  "containerEnv": {
    "LANG": "en_US.UTF-8"
  },
  "postCreateCommand": "bash ./.devcontainer/postCreateCommand.sh",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/P-manBrown/devcontainer-features/git-spice:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "extensions": "github/gh-stack"
    },
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers-extra/features/bun:1": {},
    "ghcr.io/P-manBrown/devcontainer-features/claude-code:1": {},
    "ghcr.io/P-manBrown/devcontainer-features/codex:2": {},
    "ghcr.io/P-manBrown/devcontainer-features/codebase-memory-mcp:2": {
      "autoIndex": true,
      "portRelay": true
    },
    "ghcr.io/P-manBrown/devcontainer-features/rtk:1": {
      "claudeCodeHook": true
    },
    "ghcr.io/P-manBrown/devcontainer-features/bruno-cli:1": {}
  },
  "customizations": {
    "zed": {
      "extensions": ["ruby", "dockerfile", "docker-compose", "env"]
    },
    "vscode": {
      "extensions": [
        "VisualStudioExptTeam.vscodeintellicode",
        "streetsidesoftware.code-spell-checker",
        "Gruntfuggly.todo-tree",
        "EditorConfig.EditorConfig",
        "joshbolduc.commitlint",
        "dotenv.dotenv-vscode",
        "aliariff.vscode-erb-beautify",
        "castwide.solargraph",
        "noku.rails-run-spec-vscode",
        "sporto.rails-go-to-spec",
        "KoichiSasada.vscode-rdbg",
        "Postman.postman-for-vscode",
        "cweijan.vscode-mysql-client2"
      ],
      "settings": {
        "todo-tree.general.tags": ["TODO", "TEMP"],
        "todo-tree.filtering.includeHiddenFiles": true,
        "editor.defaultFormatter": "castwide.solargraph",
        "editor.formatOnSave": true,
        "solargraph.checkGemVersion": false,
        "solargraph.diagnostics": true,
        "solargraph.formatting": true,
        "files.associations": {
          "*.html.erb": "erb"
        },
        "[erb]": {
          "editor.defaultFormatter": "aliariff.vscode-erb-beautify"
        },
        "vscode-erb-beautify.useBundler": true,
        "commitlint.config.extend.rules": {
          "type-empty": [2, "never"],
          "type-case": [2, "always", "lower-case"],
          "type-enum": [
            2,
            "always",
            [
              "build",
              "ci",
              "docs",
              "feat",
              "fix",
              "perf",
              "refactor",
              "revert",
              "test",
              "chore"
            ]
          ],
          "subject-empty": [2, "never"],
          "subject-case": [
            2,
            "never",
            [
              "upper-case",
              "camel-case",
              "kebab-case",
              "pascal-case",
              "sentence-case",
              "snake-case",
              "start-case"
            ]
          ],
          "subject-full-stop": [2, "never", "."],
          "body-leading-blank": [2, "always"],
          "footer-leading-blank": [2, "always"]
        }
      }
    }
  }
}
